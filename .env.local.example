NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- PayMongo online payments (server only, never prefix with NEXT_PUBLIC_) ---
# Supabase -> Project Settings -> API keys -> service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# PayMongo dashboard -> Developers -> API keys (use the sk_test_ key while testing)
PAYMONGO_SECRET_KEY=sk_test_xxx
# PayMongo dashboard -> Developers -> Webhooks -> your webhook's secret (whsk_...)
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# Optional: which methods to offer (default gcash,paymaya,card,grab_pay)
# PAYMONGO_PAYMENT_METHODS=gcash,paymaya,card,grab_pay,qrph
# Optional: public address used in PayMongo's return links
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
