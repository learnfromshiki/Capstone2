NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- Xendit online payments (server only, never prefix with NEXT_PUBLIC_) ---
# Supabase -> Project Settings -> API keys -> service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Xendit Dashboard -> Settings -> API keys (use the xnd_development_ key while testing;
# it needs "Money-in" write permission)
XENDIT_SECRET_KEY=xnd_development_xxx
# Xendit Dashboard -> Settings -> Webhooks -> "Webhook verification token"
XENDIT_WEBHOOK_TOKEN=your_webhook_verification_token
# Optional: which channels to offer (default: every channel switched on in Xendit)
# XENDIT_PAYMENT_CHANNELS=GCASH,PAYMAYA,GRABPAY,SHOPEEPAY,QRPH,CARDS
# Optional but recommended: the public https address used in Xendit's return links
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
